require "tmpdir"

def ensure_env!(keys)
  missing = keys.select { |key| ENV[key].to_s.strip.empty? }
  UI.user_error!("Missing required environment variables: #{missing.join(', ')}") unless missing.empty?
end

def write_temp_asc_key
  raw = ENV.fetch("ASC_KEY_P8")
  normalized = raw.include?("\\n") ? raw.gsub("\\n", "\n") : raw
  key_path = File.join(Dir.tmpdir, "asc_api_key_#{Time.now.to_i}.p8")
  File.write(key_path, normalized)
  key_path
end

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    ensure_env!(%w[
      ASC_KEY_ID
      ASC_ISSUER_ID
      ASC_KEY_P8
      MATCH_GIT_URL
      MATCH_PASSWORD
    ])

    key_path = write_temp_asc_key

    begin
      api_key = app_store_connect_api_key(
        key_id: ENV.fetch("ASC_KEY_ID"),
        issuer_id: ENV.fetch("ASC_ISSUER_ID"),
        key_filepath: key_path,
        duration: 1200
      )

      version = get_version_number(
        xcodeproj: "family-rosary.xcodeproj",
        target: "family-rosary"
      )

      latest_build =
        begin
          latest_testflight_build_number(
            api_key: api_key,
            app_identifier: "com.neilmussett.familyrosary",
            version: version
          )
        rescue
          0
        end

      new_build = latest_build + 1

      UI.message("Setting build number to #{new_build}")

      increment_build_number(
        xcodeproj: "family-rosary.xcodeproj",
        build_number: new_build.to_s
      )

      match(
        type: "appstore",
        app_identifier: ["com.neilmussett.familyrosary"],
        readonly: ENV.fetch("MATCH_READONLY", "true") == "true",
        api_key: api_key
      )

      gym(
        project: "family-rosary.xcodeproj",
        scheme: "family-rosary",
        clean: true,
        export_method: "app-store"
      )

      pilot(
        api_key: api_key,
        skip_waiting_for_build_processing: true
      )
    ensure
      File.delete(key_path) if key_path && File.exist?(key_path)
    end
  end
end

require "base64"
require "shellwords"

default_platform(:ios)

def ci?
  ENV["CI"] == "true"
end

def required_env!(keys)
  missing = keys.select { |key| ENV[key].to_s.strip.empty? }
  UI.user_error!("Missing required environment variables: #{missing.join(', ')}") unless missing.empty?
end

def next_build_number(api_key:, app_identifier:, version:)
  latest =
    begin
      latest_testflight_build_number(
        app_identifier: app_identifier,
        version: version,
        api_key: api_key
      )
    rescue StandardError => error
      UI.message("No existing TestFlight build found for version #{version}; defaulting to build 1. (#{error.message})")
      nil
    end

  latest.to_i > 0 ? latest + 1 : 1
end

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    required_env!(%w[
      ASC_KEY_ID
      ASC_ISSUER_ID
      ASC_PRIVATE_KEY_BASE64
      MATCH_GIT_URL
      MATCH_PASSWORD
    ])

    key_value = ENV["ASC_PRIVATE_KEY_BASE64"]
    is_raw_key = key_value.to_s.include?("-----BEGIN")
    UI.message("ASC key format: #{is_raw_key ? "raw" : "base64"}")

    api_key =
      if is_raw_key
        app_store_connect_api_key(
          key_id: ENV["ASC_KEY_ID"],
          issuer_id: ENV["ASC_ISSUER_ID"],
          key_content: key_value,
          duration: 1200,
          in_house: false
        )
      else
        app_store_connect_api_key(
          key_id: ENV["ASC_KEY_ID"],
          issuer_id: ENV["ASC_ISSUER_ID"],
          key_content: key_value,
          is_key_content_base64: true,
          duration: 1200,
          in_house: false
        )
      end

    version = get_version_number(
      xcodeproj: "family-rosary.xcodeproj",
      target: "family-rosary"
    )

    build_number = next_build_number(
      api_key: api_key,
      app_identifier: "com.neilmussett.familyrosary",
      version: version
    )

    UI.message("Current marketing version: #{version}")
    UI.message("Chosen build number: #{build_number}")
    UI.message("Running in CI: #{ci?}")

    increment_build_number(
      xcodeproj: "family-rosary.xcodeproj",
      build_number: build_number.to_s
    )

    UI.message("Match app identifiers: com.neilmussett.familyrosary, com.neilmussett.familyrosary.FamilyRosaryShareExtension")

    match(
      type: "appstore",
      readonly: ci?
    )

    profile_mapping = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING] || {}
    UI.message("CI_DIAG profile mapping: #{profile_mapping}")

    provisioning_profile_dirs = [
      "/Users/runner/Library/Developer/Xcode/UserData/Provisioning Profiles",
      File.expand_path("~/Library/MobileDevice/Provisioning Profiles")
    ]

    print_profile_diagnostics = lambda do |bundle_id, label|
      profile_path = nil
      app_groups = nil

      provisioning_profile_dirs.each do |directory|
        next unless Dir.exist?(directory)

        Dir[File.join(directory, "*.mobileprovision")].sort.each do |candidate|
          decoded_plist = "#{candidate}.plist"

          begin
            sh("security cms -D -i #{Shellwords.escape(candidate)} > #{Shellwords.escape(decoded_plist)}")
            application_identifier =
              sh("/usr/libexec/PlistBuddy -c #{Shellwords.escape('Print :Entitlements:application-identifier')} #{Shellwords.escape(decoded_plist)}", log: false).strip

            next unless application_identifier == "438L645H48.#{bundle_id}"

            profile_path = candidate
            begin
              app_groups =
                sh("/usr/libexec/PlistBuddy -c #{Shellwords.escape('Print :Entitlements:com.apple.security.application-groups')} #{Shellwords.escape(decoded_plist)}", log: false).strip
            rescue StandardError
              app_groups = nil
            end
            break
          rescue StandardError
            nil
          ensure
            File.delete(decoded_plist) if File.exist?(decoded_plist)
          end
        end

        break if profile_path
      end

      UI.message("CI_DIAG #{label} profile path: #{profile_path || 'MISSING'}")
      UI.message("CI_DIAG #{label} profile app groups: #{app_groups.to_s.empty? ? 'MISSING' : app_groups}")
    end

    print_profile_diagnostics.call("com.neilmussett.familyrosary", "app")
    print_profile_diagnostics.call("com.neilmussett.familyrosary.FamilyRosaryShareExtension", "extension")

    build_settings_output = sh("xcodebuild -showBuildSettings -scheme family-rosary -project family-rosary.xcodeproj 2>&1 || true", log: false)
    build_settings_patterns = [
      "CODE_SIGN_ENTITLEMENTS",
      "PRODUCT_BUNDLE_IDENTIFIER",
      "DEVELOPMENT_TEAM",
      "PROVISIONING_PROFILE",
      "PROVISIONING_PROFILE_SPECIFIER",
      "CODE_SIGN_STYLE"
    ]
    matching_build_settings = build_settings_output.to_s.split("\n").select do |line|
      build_settings_patterns.any? { |pattern| line.include?(pattern) }
    end

    if matching_build_settings.empty?
      UI.message("CI_DIAG build settings: no matching build settings were found")
    else
      matching_build_settings.each do |line|
        UI.message("CI_DIAG build settings: #{line}")
      end
    end

    match_mapping = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING] || {}
    UI.message("Passing provisioning profile mapping to gym: #{match_mapping}")

    gym(
      project: "family-rosary.xcodeproj",
      scheme: "family-rosary",
      clean: true,
      export_method: "app-store",
      export_options: {
        provisioningProfiles: match_mapping
      }
    )

    pilot(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
